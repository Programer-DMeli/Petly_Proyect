# Copiar a `.env` (excluido de Git) y ajustar valores. Nunca subir valores reales.

# --- Django ---
# Clave secreta de desarrollo. Generar una propia: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=change-me-local-development-only
# false en desarrollo con runserver; true cuando se sirva detrás de un servidor WSGI.
DJANGO_DEBUG=true
# Orígenes permitidos (CORS), separados por comas.
DJANGO_ALLOWED_ORIGINS=http://localhost:5173

# --- Base de datos (XAMPP MariaDB) ---
DB_NAME=database_petly
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=

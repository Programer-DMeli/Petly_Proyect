# Copiar a .env, excluido de Git. Completar secretos locales propios.
DJANGO_SECRET_KEY=
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,10.0.2.2
DJANGO_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DB_NAME=database_petly
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
# Mismo secreto de al menos 32 bytes que Spring Boot.
SPRING_JWT_SECRET=
PET_COMPATIBILITY_SERVICE_TOKEN=
CONTRACT_SIGNATURE_API_URL=
CONTRACT_SIGNATURE_API_TOKEN=
CONTRACT_SIGNATURE_WEBHOOK_SECRET=
CONTRACT_SIGNATURE_TIMEOUT_SECONDS=10
CONTRACT_SIGNATURE_PROVIDER=generic-rest
CONTRACT_SIGNATURE_ADAPTER_CLASS=apps.contratos.providers.ProveedorFirmaREST
ADOPTION_CONTRACT_TERMS=
PUBLIC_API_BASE_URL=http://localhost:8000
SPRING_API_URL=http://127.0.0.1:8080
# US-09: fill only with terms approved by the responsible legal/team reviewer.
ADOPTION_CONTRACT_TERMS=
ADOPTION_CONTRACT_TERMS_VERSION=
ADOPTION_CONTRACT_TERMS_APPROVED_BY=
ADOPTION_CONTRACT_TERMS_APPROVED=false
CONTRACT_SIGNATURE_PROVIDER=generic-rest
CONTRACT_SIGNATURE_API_URL=
CONTRACT_SIGNATURE_API_TOKEN=
CONTRACT_SIGNATURE_WEBHOOK_SECRET=
PUBLIC_API_BASE_URL=https://api.your-real-domain.example
PRIVATE_FILES_ROOT=private-media
# US-29: provider must accept JSON prompt + base64 image and return {"description":"..."}.
PET_DESCRIPTION_API_URL=
PET_DESCRIPTION_API_TOKEN=
DJANGO_LOG_LEVEL=INFO

# IA complementaria, solo backend. Alternativa: archivo privado .env.gemini en la raíz.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_TIMEOUT_SECONDS=20

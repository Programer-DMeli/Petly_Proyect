# Spring NO lee este archivo automáticamente: exportar variables antes de ejecutar.
DB_URL=jdbc:mariadb://127.0.0.1:3306/database_petly
DB_USERNAME=root
DB_PASSWORD=
# Secreto privado de al menos 32 bytes; compartir con Django por entorno.
SPRING_JWT_SECRET=
# Requiere endpoint y credencial de un proveedor RENIEC autorizado.
# El endpoint debe aceptar dni/nombres/apellidos y responder coincide/referencia.
RENIEC_API_URL=
RENIEC_API_TOKEN=
RENIEC_PROVIDER_NAME=RENIEC
RENIEC_API_TIMEOUT_MS=5000
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=noreply@petly.local
MAIL_PROPERTIES_MAIL_SMTP_AUTH=false
MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_ENABLE=false
RESET_LINK_BASE=petly://recuperacion
MEDIA_BASE_URL=http://10.0.2.2:8000/media/

WEB_RESET_LINK_BASE=http://localhost:5173/recuperacion

# ApiPeruDev: búsqueda para autocompletar por DNI (no es conexión directa con RENIEC).
APIPERU_DNI_URL=https://api.apiperu.dev/dni
APIPERU_API_TOKEN=

# IA complementaria, solo backend. Alternativa: archivo privado .env.gemini en la raíz.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_TIMEOUT_SECONDS=20

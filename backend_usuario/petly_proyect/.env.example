# Copiar a `.env` (excluido de Git) y ajustar valores. Nunca subir valores reales.

# --- Conexión a la base compartida `database_petly` (XAMPP MariaDB) ---
DB_URL=jdbc:mariadb://127.0.0.1:3306/database_petly?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=America/Lima&characterEncoding=utf8
DB_USERNAME=root
DB_PASSWORD=

# --- JWT (US-21) ---
# Clave secreta para firmar tokens. Debe coincidir con JWT_SECRET en Django.
SPRING_JWT_SECRET=change-me-shared-secret-for-jwt-validation

# --- Email (US-24) ---
# Configuración SMTP para envío real de emails de recuperación
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USERNAME=tu-email@gmail.com
# MAIL_PASSWORD=tu-app-password
# MAIL_PROPERTIES_MAIL_SMTP_AUTH=true
# MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_ENABLE=true
# MAIL_FROM=noreply@petly.local

# --- Django API (US-18) ---
# URL del backend Django para comunicación interna (autorización de perfiles)
# DJANGO_API_URL=http://localhost:8000

# --- Procedimiento en Windows (PowerShell) ---
# Spring Boot NO lee .env automáticamente. Opciones reales:
#
# 1) Sesión actual:
#      $env:DB_USERNAME = "usuario_local"
#      $env:DB_PASSWORD = "no_commitear"
#      .\mvnw.cmd spring-boot:run
#
# 2) Permanente para el usuario (Configuración del sistema > Variables de entorno):
#      crear DB_URL, DB_USERNAME y DB_PASSWORD como variables de usuario.
#
# 3) Script que cargue un .env fuera de Git antes de arrancar.
